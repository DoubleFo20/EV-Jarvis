# Runtime
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (server-only values; leave blank until configured locally)
DATABASE_URL=
DIRECT_URL=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required only for the destructive DEV Auth verifier. Keep disabled by default.
EV_JARVIS_ENVIRONMENT=
EV_JARVIS_DEV_PROJECT_REF_SHA256=
ALLOW_DESTRUCTIVE_AUTH_DEV_VERIFICATION=false

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BCRYPT_ROUNDS=12
